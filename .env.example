# PostgreSQL password for Odoo database
POSTGRES_PASSWORD=odoo

# Claude model (default: sonnet)
SEFER_MODEL=sonnet

# Resend API key for email verification
RESEND_API_KEY=re_...

# Note: Claude Code CLI authenticates via OAuth (claude login).
# Sefer uses its OWN Claude Code credentials, separate from dev.
# First run: docker compose exec sefer claude login
# Credentials persist in data/claude-home/
